# Shared bearer token to start; use a long random value and keep it private.
DASHBOARD_API_TOKEN=replace-with-another-long-random-token
ALLOWED_ORIGINS=http://localhost:8000
RECEIPT_DIR=./private_receipts
TIMEZONE=Asia/Kolkata
PORT=8000
