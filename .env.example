APP_SECRET=replace-with-long-random-secret
DATABASE_URL=sqlite:///./pishukkan.db
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Natural-language questions use Groq first, then Gemini when set to auto.
LLM_PROVIDER=auto
GEMINI_API_KEY=
